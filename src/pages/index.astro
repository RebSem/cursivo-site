---
import HomePage from "../components/HomePage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { englishSiteChrome } from "../data/landing";
---

<BaseLayout
	title="Cursivo | AI agent + CRM for Dubai car rental operators"
	description="Cursivo is one product: an AI agent that replies in Telegram and WhatsApp, and a CRM that fills itself with branch-ready lead cards, quotes, and manager tasks."
	lang="en"
	brandMeta={englishSiteChrome.brandMeta}
	navItems={englishSiteChrome.navItems}
	localeLinks={englishSiteChrome.localeLinks}
	currentLocale={englishSiteChrome.currentLocale}
	footerTitle={englishSiteChrome.footerTitle}
	footerCopy={englishSiteChrome.footerCopy}
	footerMetaLabel={englishSiteChrome.footerMetaLabel}
	footerMetaValue={englishSiteChrome.footerMetaValue}
	canonicalPath="/"
	ctaHref="#contact"
>
	<div class="site-container">
		<HomePage locale="en" contactHref="#contact" />
	</div>
</BaseLayout>
