---
import HeroPipelineSimulator from "./HeroPipelineSimulator.astro";
import RequestDemoSection from "./RequestDemoSection.astro";
import StickyDemoButton from "./StickyDemoButton.astro";
import type { Locale } from "../data/site";
import { getStrings } from "../data/strings";

interface Props {
	locale?: Locale;
	contactHref?: string;
}

const { locale = "en", contactHref = "#contact" } = Astro.props;
const s = getStrings(locale).home;
const ctaPrimary = getStrings(locale).ctaPrimary;
const ctaSecondary = getStrings(locale).ctaSecondary;

const tabs = [
	{ id: "agent", label: s.tabAgent, title: s.panelAgentTitle, copy: s.panelAgentCopy },
	{ id: "inbox", label: s.tabInbox, title: s.panelInboxTitle, copy: s.panelInboxCopy },
	{ id: "leads", label: s.tabLeads, title: s.panelLeadsTitle, copy: s.panelLeadsCopy },
	{ id: "catalog", label: s.tabCatalog, title: s.panelCatalogTitle, copy: s.panelCatalogCopy },
	{ id: "quotes", label: s.tabQuotes, title: s.panelQuotesTitle, copy: s.panelQuotesCopy },
];

const steps = [
	{ eyebrow: s.step1Eyebrow, title: s.step1Title, copy: s.step1Copy, hint: s.step1Hint },
	{ eyebrow: s.step2Eyebrow, title: s.step2Title, copy: s.step2Copy, hint: s.step2Hint },
	{ eyebrow: s.step3Eyebrow, title: s.step3Title, copy: s.step3Copy, hint: s.step3Hint },
];

const trustCards = [
	{ value: s.trust1Value, label: s.trust1Label, hint: s.trust1Hint },
	{ value: s.trust2Value, label: s.trust2Label, hint: s.trust2Hint },
	{ value: s.trust3Value, label: s.trust3Label, hint: s.trust3Hint },
	{ value: s.trust4Value, label: s.trust4Label, hint: s.trust4Hint },
];

---

<div class="page-stack home-page">
	<!-- HERO: open-air, not boxed in a section-card -->
	<section class="home-hero" data-home-hero data-reveal="soft">
		<div class="home-hero-copy">
			<div class="home-hero-tag">
				<span class="home-hero-tag-dot"></span>
				<span class="home-hero-tag-label">{s.eyebrow}</span>
			</div>
			<h1 class="home-h1">
				<span class="home-h1-line">{s.h1Line1}</span>
				<span class="home-h1-line home-h1-line-accent">{s.h1Line2}</span>
			</h1>
			<p class="home-lede type-body-lg text-muted">{s.lede}</p>

			<div class="home-hero-actions">
				<a class="home-hero-primary" href={contactHref}>{ctaPrimary}</a>
				<a class="home-hero-secondary" href="#flow">{ctaSecondary}</a>
			</div>

			<div class="home-hero-chips">
				<span>{s.heroChip1}</span>
				<span>{s.heroChip2}</span>
				<span>{s.heroChip3}</span>
			</div>
			<p class="home-twin">{s.twinNote}</p>
		</div>

		<div class="home-hero-visual" aria-hidden="true">
			<div class="home-hero-visual-frame">
				<HeroPipelineSimulator locale={locale} />
			</div>
		</div>
	</section>

	<!-- PAIN: asymmetric bento — one big "hero pain" + three flanking -->
	<section class="pain section-card" id="benefits" data-reveal="soft">
		<header class="pain-head">
			<p class="type-label pain-eyebrow">{s.painEyebrow}</p>
			<h2 class="type-h2">{s.painTitle}</h2>
		</header>

		<div class="pain-bento">
			<article class="pain-big">
				<div class="pain-big-marker" aria-hidden="true">
					<span class="pain-big-pulse"></span>
					03:14
				</div>
				<h3 class="pain-big-title">{s.painBigTitle}</h3>
				<p class="pain-big-copy text-muted">{s.painBigCopy}</p>
				<div class="pain-big-stat">
					<strong>{s.painBigMetric}</strong>
					<span>{s.painBigMetricLabel}</span>
				</div>
			</article>

			<article class="pain-mini pain-mini-1">
				<svg class="pain-mini-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M4 6h7v4H4z" />
					<path d="M13 14h7v4h-7z" />
					<path d="M11 8h2v8h-2z" />
				</svg>
				<h3>{s.painPipelineTitle}</h3>
				<p class="text-muted">{s.painPipelineCopy}</p>
			</article>

			<article class="pain-mini pain-mini-2">
				<svg class="pain-mini-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M6 5h12v14H6z" />
					<path d="M9 9h6" />
					<path d="M9 13h6" />
				</svg>
				<h3>{s.painQuotesTitle}</h3>
				<p class="text-muted">{s.painQuotesCopy}</p>
			</article>

			<article class="pain-mini pain-mini-3">
				<svg class="pain-mini-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M12 5v14" />
					<path d="M7 9h10" />
					<path d="M5 17h4" />
					<path d="M15 17h4" />
				</svg>
				<h3>{s.painBranchesTitle}</h3>
				<p class="text-muted">{s.painBranchesCopy}</p>
			</article>
		</div>
	</section>

	<!-- SOLUTION: 5 tabs, Agent first -->
	<section class="solution section-card" id="solution" data-reveal="soft">
		<header class="solution-head">
			<p class="type-label solution-eyebrow">{s.solutionEyebrow}</p>
			<h2 class="type-h2">{s.solutionTitle}</h2>
			<p class="solution-lede text-muted">{s.solutionLede}</p>
		</header>

		<div class="solution-tabs" data-solution-tabs>
			<div class="solution-tab-list" role="tablist" aria-label="Product surfaces">
				{tabs.map((tab, index) => (
					<button
						type="button"
						class:list={["solution-tab-button", index === 0 && "is-active"]}
						role="tab"
						aria-selected={index === 0 ? "true" : "false"}
						aria-controls={`panel-${tab.id}`}
						data-tab-target={tab.id}
					>
						{tab.label}
					</button>
				))}
			</div>

			{tabs.map((tab, index) => (
				<div
					class:list={["solution-panel", index === 0 && "is-active"]}
					id={`panel-${tab.id}`}
					role="tabpanel"
					data-tab-panel={tab.id}
					hidden={index === 0 ? undefined : true}
				>
					<div class="solution-copy">
						<h3>{tab.title}</h3>
						<p class="text-muted">{tab.copy}</p>
					</div>

					{tab.id === "agent" && (
						<div class="solution-preview agent-preview" aria-hidden="true">
							<div class="agent-status">
								<span class="agent-status-dot"></span>
								<span class="agent-status-label">{s.flowLiveLabel}</span>
								<span class="agent-status-time" data-agent-time>14 {s.flowSecondsAgo}</span>
							</div>
							<div class="agent-bubble agent-bubble-in">{s.flowChatMsg1}</div>
							<div class="agent-bubble agent-bubble-sys">{s.flowChatMsg2}</div>
							<div class="agent-bubble agent-bubble-out">{s.flowChatMsg3}</div>
						</div>
					)}

					{tab.id === "inbox" && (
						<div class="solution-preview inbox-preview" aria-hidden="true">
							<aside>
								<strong>Queues</strong>
								<span>Dubai Marina</span>
								<span>Airport desk</span>
								<span>VIP hotline</span>
							</aside>
							<div class="preview-main">
								<header>
									<strong>Ahmed R.</strong>
									<span>Marina · live</span>
								</header>
								<div class="chat-row is-incoming">Need a G-Class for Friday evening.</div>
								<div class="chat-row is-system">AI · luxury · short-term · Marina</div>
								<div class="chat-row is-outgoing">Sharing options + pickup terms.</div>
							</div>
						</div>
					)}

					{tab.id === "leads" && (
						<div class="solution-preview leads-preview" aria-hidden="true">
							<div>
								<header>Qualified</header>
								<div class="mini-lead"><strong>Tourist SUV · 5d</strong><span>DXB arrivals</span></div>
								<div class="mini-lead"><strong>Urgent sedan</strong><span>Downtown</span></div>
							</div>
							<div>
								<header>Quoted</header>
								<div class="mini-lead"><strong>BMW 520i · 2d</strong><span>AED 1,840</span></div>
							</div>
							<div>
								<header>Reserved</header>
								<div class="mini-lead"><strong>Range Rover · 4d</strong><span>Marina · Sat</span></div>
							</div>
						</div>
					)}

					{tab.id === "catalog" && (
						<div class="solution-preview catalog-preview" aria-hidden="true">
							<div class="catalog-card">
								<strong>Mercedes G63</strong>
								<span>Luxury SUV · Marina</span>
								<ul>
									<li>AED 2,150 / day</li>
									<li>Ready today</li>
									<li>3,500 deposit</li>
								</ul>
							</div>
							<div class="catalog-card">
								<strong>BMW 520i</strong>
								<span>Executive · Downtown</span>
								<ul>
									<li>AED 920 / day</li>
									<li>Weekend package</li>
									<li>1,200 deposit</li>
								</ul>
							</div>
						</div>
					)}

					{tab.id === "quotes" && (
						<div class="solution-preview quotes-preview" aria-hidden="true">
							<header>
								<strong>Quote · #DXB-204</strong>
								<span>Prepared 22s ago</span>
							</header>
							<div class="quote-grid">
								<div><span>Vehicle</span><strong>Range Rover Sport</strong></div>
								<div><span>Rental</span><strong>3 days · Fri → Mon</strong></div>
								<div><span>Pickup</span><strong>Marina · 19:30</strong></div>
								<div><span>Total</span><strong>AED 6,400</strong></div>
							</div>
						</div>
					)}
				</div>
			))}
		</div>
	</section>

	<!-- AI FLOW: hero of the page, open-air, asymmetric, perpetual motion -->
	<section class="flow" id="flow" data-ai-flow data-reveal="soft">
		<header class="flow-head">
			<p class="type-label flow-eyebrow">{s.flowEyebrow}</p>
			<h2 class="type-h2">{s.flowTitle}</h2>
			<p class="flow-copy text-muted">{s.flowCopy}</p>
		</header>

		<div class="flow-grid">
			<div class="flow-chat" data-flow-chat>
				<header>
					<span class="flow-chat-dot"></span>
					Telegram
					<span class="flow-chat-time" data-flow-time>03:14</span>
				</header>
				<div class="flow-bubble is-incoming" data-flow-message={s.flowChatMsg1}></div>
				<div class="flow-bubble is-system" data-flow-message={s.flowChatMsg2}></div>
				<div class="flow-bubble is-outgoing" data-flow-message={s.flowChatMsg3}></div>
			</div>

			<svg class="flow-path" viewBox="0 0 200 320" preserveAspectRatio="none" aria-hidden="true">
				<path
					d="M 4 32 C 90 32, 100 160, 196 160 M 196 160 C 100 160, 90 288, 4 288"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					pathLength="100"
					data-flow-path
				/>
			</svg>

			<div class="flow-card" data-flow-card>
				<div class="flow-card-head">
					<p class="type-label">{s.flowCrmLabel}</p>
					<span class="flow-live">
						<span class="flow-live-dot"></span>
						{s.flowLiveLabel}
					</span>
				</div>
				<strong class="flow-card-title">{s.flowCrmLeadTitle}</strong>
				<ul>
					<li>{s.flowCrmItem1}</li>
					<li>{s.flowCrmItem2}</li>
					<li>{s.flowCrmItem3}</li>
				</ul>
			</div>

			<div class="flow-task" data-flow-task>
				<p class="type-label">{s.flowTaskLabel}</p>
				<strong>{s.flowTaskTitle}</strong>
				<span class="flow-task-assigned">{s.flowTaskAssigned}</span>
			</div>
		</div>
	</section>

	<!-- STEPS: zigzag timeline -->
	<section class="steps section-card" id="how-it-works" data-reveal="soft">
		<header class="steps-head">
			<p class="type-label steps-eyebrow">{s.stepsEyebrow}</p>
			<h2 class="type-h2">{s.stepsTitle}</h2>
		</header>

		<ol class="steps-list">
			{steps.map((step, index) => (
				<li class:list={["steps-item", `steps-item-${index + 1}`]}>
					<div class="steps-copy">
						<p class="type-label steps-step">{step.eyebrow}</p>
						<h3 class="steps-title">{step.title}</h3>
						<p class="steps-body text-muted">{step.copy}</p>
						<p class="steps-hint">{step.hint}</p>
					</div>

					<div class="steps-preview" aria-hidden="true">
						{index === 0 && (
							<div class="steps-preview-sheet">
								<header><strong>fleet-marina.xlsx</strong><span>27 cars · 3 branches</span></header>
								<div class="row"><span>G63</span><span>Marina</span><span>AED 2,150</span></div>
								<div class="row"><span>520i</span><span>Downtown</span><span>AED 920</span></div>
								<div class="row is-ghost"><span>Prado</span><span>Airport</span><span>AED 840</span></div>
							</div>
						)}
						{index === 1 && (
							<div class="steps-preview-token">
								<header>Telegram bot</header>
								<code class="steps-token">cursivo://connect/7461<span class="steps-cursor"></span></code>
								<span class="steps-token-state">Listening for next message…</span>
							</div>
						)}
						{index === 2 && (
							<div class="steps-preview-board">
								<header>Marina · this morning</header>
								<div class="row"><strong>Quote AED 6,400</strong><span>Ready</span></div>
								<div class="row"><strong>Quote AED 2,940</strong><span>Ready</span></div>
								<div class="row"><strong>Quote AED 1,560</strong><span>Ready</span></div>
							</div>
						)}
					</div>
				</li>
			))}
		</ol>
	</section>

	<!-- TRUST: outcome cards with honest numbers -->
	<section class="trust section-card" id="why-cursivo" data-reveal="soft">
		<header class="trust-head">
			<p class="type-label trust-eyebrow">{s.trustEyebrow}</p>
			<h2 class="type-h2">{s.trustTitle}</h2>
		</header>

		<div class="trust-grid">
			{trustCards.map((item) => (
				<article class="trust-card">
					<strong>{item.value}</strong>
					<span class="trust-label">{item.label}</span>
					<span class="trust-hint">{item.hint}</span>
				</article>
			))}
		</div>
	</section>

	<RequestDemoSection locale={locale} />
</div>

<StickyDemoButton
	href={contactHref}
	thresholdSelector="[data-home-hero]"
	hideNearSelector="[data-request-demo]"
	locale={locale}
/>

<style>
	/* ----- LAYOUT ATOMS ----- */
	.home-page {
		gap: clamp(2.25rem, 5vw, 4rem);
	}

	/* ============================================
	   HERO — open-air, asymmetric, capped height
	   ============================================ */
	.home-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: center;
		padding: clamp(2.2rem, 5vw, 4rem) 0 clamp(1.4rem, 3vw, 2rem);
	}

	/* Page-level ambience now lives on body (background-attachment: fixed),
	   so the hero stays a clean open-air box without its own gradient seam. */

	.home-hero-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.85rem 0.4rem 0.65rem;
		margin-bottom: var(--space-5);
		border-radius: 999px;
		background: rgba(201, 106, 58, 0.08);
		border: 1px solid rgba(201, 106, 58, 0.18);
		width: max-content;
	}

	.home-hero-tag-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-terracotta);
		box-shadow: 0 0 0 0 rgba(201, 106, 58, 0.45);
		animation: heroTagPulse 2s ease-in-out infinite;
	}

	@keyframes heroTagPulse {
		0%, 100% { box-shadow: 0 0 0 0 rgba(201, 106, 58, 0.45); }
		50% { box-shadow: 0 0 0 0.45rem rgba(201, 106, 58, 0); }
	}

	.home-hero-tag-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-terracotta-active);
		font-weight: 700;
	}

	:lang(ar) .home-hero-tag-label {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
		font-size: 0.85rem;
	}

	.home-h1 {
		display: grid;
		gap: 0.1rem;
		margin-bottom: var(--space-5);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.6rem, 5vw, 4.1rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
		max-width: 18ch;
		text-wrap: balance;
	}

	.home-h1-line {
		display: block;
	}

	.home-h1-line-accent {
		color: var(--color-terracotta);
	}

	.home-lede {
		margin: 0 0 var(--space-5);
		max-width: 36rem;
		font-size: 1.08rem;
		line-height: 1.55;
	}

	.home-twin {
		margin: var(--space-4) 0 0;
		padding: 0.75rem 1rem;
		border-left: 2px solid rgba(201, 106, 58, 0.35);
		font-family: var(--font-body);
		font-size: 0.86rem;
		line-height: 1.55;
		color: var(--color-slate);
		max-width: 38rem;
		font-style: italic;
	}

	:lang(ar) .home-twin {
		border-left: none;
		border-right: 2px solid rgba(201, 106, 58, 0.35);
		font-style: normal;
		font-size: 0.88rem;
	}

	.home-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-5);
	}

	.home-hero-primary,
	.home-hero-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 1.25rem;
		border-radius: var(--radius-pill);
		text-decoration: none;
		font-weight: 700;
		transition:
			transform var(--motion-fast) var(--motion-spring),
			background var(--motion-fast) ease,
			border-color var(--motion-fast) ease,
			box-shadow var(--motion-fast) ease;
	}

	.home-hero-primary {
		background: linear-gradient(165deg, #ff6b35, #c96a3a);
		color: #ffffff;
		font-weight: 800;
		border: 1px solid rgba(255, 255, 255, 0.22);
		box-shadow:
			0 6px 18px rgba(255, 107, 53, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.25);
	}

	.home-hero-primary:hover {
		filter: brightness(1.08);
		transform: translateY(-2px) scale(1.02);
		box-shadow:
			0 12px 28px rgba(255, 107, 53, 0.42),
			inset 0 1px 0 rgba(255, 255, 255, 0.32);
	}

	.home-hero-primary:active {
		transform: scale(0.97);
	}

	.home-hero-secondary {
		border: 1px solid var(--color-border-sand);
		background: var(--surface-card);
		color: var(--color-ink);
	}

	.home-hero-secondary:hover {
		border-color: var(--color-terracotta);
		transform: translateY(-1px);
	}

	.home-hero-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: var(--space-5);
	}

	.home-hero-chips span {
		padding: 0.45rem 0.75rem;
		border-radius: var(--radius-pill);
		background: rgba(255, 253, 249, 0.7);
		border: 1px solid var(--color-border-sand);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-terracotta-active);
		backdrop-filter: blur(8px);
	}

	:lang(ar) .home-hero-chips span {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
		font-size: 0.85rem;
	}

	.home-hero-visual {
		position: relative;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		min-height: 24rem;
	}

	.home-hero-visual-frame {
		width: 100%;
		max-width: 30rem;
		opacity: 0.96;
		filter: saturate(0.92);
		transition:
			opacity 320ms ease,
			filter 320ms ease,
			transform 320ms var(--motion-spring);
	}

	.home-hero-visual-frame:hover {
		opacity: 1;
		filter: saturate(1);
	}

	:lang(ar) .home-hero-visual {
		justify-content: flex-start;
	}

	@media (max-width: 1080px) {
		.home-hero-visual-frame {
			max-width: 100%;
		}
	}

	/* ============================================
	   PAIN — bento, asymmetric, no 4-equal-columns
	   ============================================ */
	.pain {
		display: grid;
		gap: clamp(1.4rem, 2.5vw, 2rem);
	}

	.pain-head {
		display: grid;
		gap: 0.4rem;
		max-width: 38rem;
	}

	.pain-eyebrow {
		color: var(--color-terracotta);
	}

	.pain-bento {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		grid-template-rows: repeat(3, minmax(0, 1fr));
		gap: clamp(0.85rem, 1.4vw, 1.1rem);
		min-height: 28rem;
	}

	.pain-big {
		grid-column: 1;
		grid-row: 1 / span 3;
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 1rem;
		padding: clamp(1.3rem, 2.4vw, 1.85rem);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(165deg, rgba(40, 71, 102, 0.06), rgba(201, 106, 58, 0.04)),
			var(--surface-card);
		border: 1px solid rgba(113, 88, 62, 0.18);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
		position: relative;
		overflow: clip;
	}

	.pain-big::after {
		content: "";
		position: absolute;
		inset: -40% -10% auto auto;
		width: 60%;
		aspect-ratio: 1;
		background: radial-gradient(circle, rgba(201, 106, 58, 0.18), transparent 60%);
		pointer-events: none;
	}

	.pain-big-marker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.7rem 0.35rem 0.5rem;
		border-radius: var(--radius-pill);
		background: rgba(20, 32, 51, 0.08);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		color: var(--color-ink);
		width: max-content;
	}

	.pain-big-pulse {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-terracotta);
		box-shadow: 0 0 0 0 rgba(201, 106, 58, 0.45);
		animation: painPulse 1.8s ease-out infinite;
	}

	@keyframes painPulse {
		0% { box-shadow: 0 0 0 0 rgba(201, 106, 58, 0.45); }
		70% { box-shadow: 0 0 0 0.6rem rgba(201, 106, 58, 0); }
		100% { box-shadow: 0 0 0 0 rgba(201, 106, 58, 0); }
	}

	.pain-big-title {
		font-size: clamp(1.6rem, 3vw, 2.15rem);
		line-height: 1.05;
		letter-spacing: -0.035em;
		max-width: 14ch;
	}

	.pain-big-copy {
		margin: 0;
		max-width: 42ch;
	}

	.pain-big-stat {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem 1rem;
		align-items: end;
		padding-top: 0.85rem;
		border-top: 1px solid rgba(113, 88, 62, 0.16);
	}

	.pain-big-stat strong {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.85rem);
		line-height: 1;
		color: var(--color-terracotta);
		letter-spacing: -0.04em;
	}

	.pain-big-stat span {
		color: var(--color-slate);
		font-size: var(--text-small);
		line-height: 1.45;
		max-width: 30ch;
	}

	.pain-mini {
		grid-column: 2;
		display: grid;
		gap: 0.5rem;
		padding: 1.1rem 1.2rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border-sand);
		background: var(--surface-card);
		transition:
			transform var(--motion-fast) var(--motion-spring),
			border-color var(--motion-fast) ease,
			box-shadow var(--motion-fast) ease;
	}

	.pain-mini:hover {
		transform: translateY(-2px);
		border-color: rgba(201, 106, 58, 0.3);
		box-shadow: 0 14px 28px rgba(20, 32, 51, 0.08);
	}

	.pain-mini h3 {
		font-size: 1.05rem;
		line-height: 1.2;
	}

	.pain-mini p {
		margin: 0;
		font-size: 0.93rem;
		line-height: 1.5;
	}

	.pain-mini-icon {
		width: 1.2rem;
		height: 1.2rem;
		stroke: var(--color-terracotta-active);
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* ============================================
	   SOLUTION
	   ============================================ */
	.solution {
		display: grid;
		gap: clamp(1.25rem, 2vw, 1.75rem);
	}

	.solution-head {
		display: grid;
		gap: 0.35rem;
		max-width: 44rem;
	}

	.solution-eyebrow {
		color: var(--color-terracotta);
	}

	.solution-lede {
		margin: 0.35rem 0 0;
		max-width: 42rem;
	}

	.solution-tabs {
		display: grid;
		gap: 1.1rem;
	}

	.solution-tab-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.solution-tab-button {
		padding: 0.6rem 1rem;
		border: 1px solid var(--color-border-sand);
		border-radius: var(--radius-pill);
		background: var(--surface-card);
		color: var(--color-slate);
		font-weight: 600;
		cursor: pointer;
		transition:
			background var(--motion-fast) ease,
			color var(--motion-fast) ease,
			border-color var(--motion-fast) ease,
			transform var(--motion-fast) var(--motion-spring);
	}

	.solution-tab-button:hover {
		transform: translateY(-1px);
		border-color: var(--color-terracotta);
		color: var(--color-ink);
	}

	.solution-tab-button.is-active {
		background: var(--color-accent-soft);
		border-color: var(--color-terracotta);
		color: var(--color-terracotta-active);
	}

	.solution-panel {
		display: none;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(1rem, 2vw, 1.6rem);
		align-items: center;
		opacity: 0;
		transform: translateY(0.4rem);
		transition:
			opacity var(--motion-base) var(--motion-spring),
			transform var(--motion-base) var(--motion-spring);
	}

	.solution-panel.is-active {
		display: grid;
		opacity: 1;
		transform: translateY(0);
	}

	.solution-copy h3 {
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		line-height: 1.15;
		margin-bottom: var(--space-3);
		max-width: 22ch;
	}

	.solution-copy p {
		margin: 0;
		max-width: 38ch;
	}

	.solution-preview {
		display: grid;
		gap: 0.75rem;
		padding: 1.1rem;
		border: 1px solid var(--color-border-sand);
		border-radius: var(--radius-xl);
		background: linear-gradient(180deg, var(--surface-card), var(--surface-raised));
		box-shadow: var(--shadow-card);
		min-height: 18rem;
	}

	.inbox-preview {
		grid-template-columns: 11rem 1fr;
	}

	.inbox-preview aside,
	.preview-main {
		padding: 0.85rem;
		border-radius: 1rem;
		background: var(--surface-page);
		display: grid;
		gap: 0.6rem;
		align-content: start;
	}

	.inbox-preview aside strong { font-size: 0.95rem; }
	.inbox-preview aside span { color: var(--color-slate); font-size: var(--text-small); }
	.preview-main header { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; }
	.preview-main header span { color: var(--color-slate); font-size: var(--text-small); }

	.chat-row {
		padding: 0.7rem 0.85rem;
		border-radius: 0.85rem;
		background: var(--surface-card);
		font-size: var(--text-small);
	}

	.chat-row.is-system {
		background: var(--color-accent-soft);
		color: var(--color-terracotta-active);
		font-family: var(--font-mono);
		letter-spacing: 0.04em;
	}

	:lang(ar) .chat-row.is-system {
		font-family: var(--font-arabic);
		letter-spacing: 0;
	}

	.chat-row.is-outgoing {
		background: var(--color-navy-soft);
		color: var(--color-ink);
	}

	.leads-preview {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.leads-preview > div {
		padding: 0.85rem;
		border-radius: 1rem;
		background: var(--surface-page);
		display: grid;
		gap: 0.65rem;
		align-content: start;
	}

	.leads-preview header { font-weight: 700; font-size: 0.95rem; }

	.mini-lead {
		display: grid;
		gap: 0.25rem;
		padding: 0.65rem 0.75rem;
		border-radius: 0.8rem;
		background: var(--surface-card);
	}

	.mini-lead strong { font-size: 0.95rem; }
	.mini-lead span { color: var(--color-slate); font-size: var(--text-small); }

	.catalog-preview {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.catalog-card {
		display: grid;
		gap: 0.4rem;
		padding: 0.95rem;
		border-radius: 1rem;
		background: var(--surface-page);
	}

	.catalog-card strong { font-size: 1.05rem; }
	.catalog-card span { color: var(--color-slate); font-size: var(--text-small); }
	.catalog-card ul {
		margin: 0.35rem 0 0;
		padding-left: 1rem;
		color: var(--color-slate);
		font-size: var(--text-small);
		display: grid;
		gap: 0.2rem;
	}

	.quotes-preview header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.quotes-preview header strong { font-size: 1.05rem; }
	.quotes-preview header span { color: var(--color-slate); font-size: var(--text-small); }

	.quote-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
		margin-top: 0.85rem;
	}

	.quote-grid div {
		display: grid;
		gap: 0.2rem;
		padding: 0.7rem 0.8rem;
		border-radius: 0.85rem;
		background: var(--surface-page);
	}

	.quote-grid span { color: var(--color-slate); font-size: var(--text-small); }
	.quote-grid strong { font-size: 0.96rem; }

	/* Agent preview (first tab) */
	.agent-preview {
		display: grid;
		gap: 0.7rem;
		background: linear-gradient(180deg, var(--surface-card), rgba(40, 71, 102, 0.06));
	}

	.agent-status {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius-pill);
		background: var(--surface-page);
		width: max-content;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	:lang(ar) .agent-status {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
		font-size: 0.85rem;
	}

	.agent-status-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-success);
		box-shadow: 0 0 0 0 rgba(47, 138, 98, 0.5);
		animation: agentPulse 1.6s ease-in-out infinite;
	}

	@keyframes agentPulse {
		0%, 100% { box-shadow: 0 0 0 0 rgba(47, 138, 98, 0.5); }
		50% { box-shadow: 0 0 0 0.5rem rgba(47, 138, 98, 0); }
	}

	.agent-status-label { color: var(--color-success); font-weight: 700; }
	.agent-status-time { color: var(--color-slate); margin-left: auto; }

	.agent-bubble {
		padding: 0.8rem 0.95rem;
		border-radius: 1rem;
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.agent-bubble-in {
		background: var(--surface-page);
		max-width: 85%;
	}

	.agent-bubble-sys {
		background: var(--color-accent-soft);
		color: var(--color-terracotta-active);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.05em;
		max-width: 85%;
	}

	:lang(ar) .agent-bubble-sys {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		font-size: 0.88rem;
	}

	.agent-bubble-out {
		background: var(--color-navy-soft);
		color: var(--color-ink);
		max-width: 85%;
		justify-self: end;
	}

	/* ============================================
	   FLOW — open-air, asymmetric
	   ============================================ */
	.flow {
		position: relative;
		display: grid;
		gap: clamp(1.4rem, 2.5vw, 2rem);
		padding: clamp(1rem, 2.5vw, 2rem) 0;
	}

	.flow-head {
		display: grid;
		gap: 0.5rem;
		max-width: 46rem;
	}

	.flow-eyebrow {
		color: var(--color-terracotta);
	}

	.flow-copy {
		margin: 0;
		max-width: 42rem;
	}

	.flow-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(13rem, 14rem) minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-areas:
			"chat path card"
			"chat path task";
		gap: 1rem;
		align-items: stretch;
		color: var(--color-terracotta);
	}

	.flow-chat {
		grid-area: chat;
		display: grid;
		gap: 0.8rem;
		align-content: start;
		padding: 1.15rem 1.2rem;
		border-radius: var(--radius-xl);
		background: linear-gradient(180deg, var(--surface-card), var(--surface-raised));
		border: 1px solid var(--color-border-sand);
		box-shadow: var(--shadow-card);
	}

	.flow-chat header {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(113, 88, 62, 0.14);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	:lang(ar) .flow-chat header {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
	}

	.flow-chat-dot {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-success);
		box-shadow: 0 0 0 0 rgba(47, 138, 98, 0.5);
		animation: agentPulse 1.8s ease-in-out infinite;
	}

	.flow-chat-time {
		margin-left: auto;
		color: var(--color-slate);
	}

	.flow-bubble {
		min-height: 2.6rem;
		padding: 0.8rem 0.95rem;
		border-radius: 1rem;
		background: var(--surface-page);
		color: var(--color-slate);
		font-size: 0.95rem;
		line-height: 1.45;
		opacity: 0.42;
		transform: translateY(0.2rem);
		transition:
			opacity var(--motion-fast) ease,
			transform var(--motion-fast) var(--motion-spring);
	}

	.flow-bubble.is-current,
	.flow-bubble.is-complete {
		opacity: 1;
		transform: translateY(0);
	}

	.flow-bubble.is-system {
		background: var(--color-accent-soft);
		color: var(--color-terracotta-active);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
	}

	:lang(ar) .flow-bubble.is-system {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		font-size: 0.92rem;
	}

	.flow-bubble.is-outgoing {
		background: var(--color-navy-soft);
		color: var(--color-ink);
	}

	.flow-path {
		grid-area: path;
		width: 100%;
		height: 100%;
		min-height: 14rem;
		pointer-events: none;
	}

	.flow-path path {
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		transition: stroke-dashoffset 1.4s var(--motion-spring) 0.2s;
	}

	[data-ai-flow].is-flowed .flow-path path {
		stroke-dashoffset: 0;
	}

	.flow-card,
	.flow-task {
		padding: 1.1rem 1.15rem;
		border-radius: var(--radius-xl);
		background: var(--surface-card);
		border: 1px solid var(--color-border-sand);
		box-shadow: var(--shadow-card);
		display: grid;
		align-content: start;
		gap: 0.5rem;
		opacity: 0.55;
		transform: translateY(0.5rem) scale(0.995);
		transition:
			opacity var(--motion-base) var(--motion-spring),
			transform var(--motion-base) var(--motion-spring);
	}

	.flow-card.is-active,
	.flow-task.is-active {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.flow-card { grid-area: card; }
	.flow-task { grid-area: task; }

	.flow-card-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6rem;
	}

	.flow-live {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.18rem 0.55rem 0.18rem 0.45rem;
		border-radius: var(--radius-pill);
		background: rgba(47, 138, 98, 0.1);
		color: var(--color-success);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	:lang(ar) .flow-live {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
	}

	.flow-live-dot {
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-success);
		box-shadow: 0 0 0 0 rgba(47, 138, 98, 0.5);
		animation: agentPulse 1.6s ease-in-out infinite;
	}

	.flow-card-title {
		font-size: 1.05rem;
		line-height: 1.2;
	}

	.flow-card ul {
		margin: 0;
		padding-left: 1rem;
		color: var(--color-slate);
		font-size: var(--text-small);
		display: grid;
		gap: 0.2rem;
	}

	.flow-task strong {
		font-size: 1rem;
		line-height: 1.25;
	}

	.flow-task-assigned {
		color: var(--color-slate);
		font-size: var(--text-small);
	}

	/* ============================================
	   STEPS — zigzag timeline with mini previews
	   ============================================ */
	.steps {
		display: grid;
		gap: clamp(1.4rem, 2.4vw, 2rem);
	}

	.steps-head {
		display: grid;
		gap: 0.4rem;
		max-width: 38rem;
	}

	.steps-eyebrow {
		color: var(--color-terracotta);
	}

	.steps-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(1.4rem, 3vw, 2.4rem);
		position: relative;
	}

	.steps-list::before {
		content: "";
		position: absolute;
		left: 50%;
		top: 0.5rem;
		bottom: 0.5rem;
		width: 1px;
		background: repeating-linear-gradient(
			to bottom,
			rgba(113, 88, 62, 0.25) 0,
			rgba(113, 88, 62, 0.25) 6px,
			transparent 6px,
			transparent 12px
		);
		transform: translateX(-50%);
	}

	.steps-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		align-items: center;
		position: relative;
	}

	.steps-item-2 .steps-copy { order: 2; }
	.steps-item-2 .steps-preview { order: 1; }

	.steps-step {
		color: var(--color-terracotta);
		margin-bottom: 0.5rem;
	}

	.steps-title {
		font-size: clamp(1.5rem, 2.6vw, 1.95rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		max-width: 18ch;
		margin-bottom: 0.6rem;
	}

	.steps-body {
		margin: 0 0 0.85rem;
		max-width: 42ch;
	}

	.steps-hint {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-terracotta-active);
	}

	:lang(ar) .steps-hint {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
	}

	.steps-preview {
		padding: 1rem 1.15rem;
		border-radius: var(--radius-xl);
		background: var(--surface-card);
		border: 1px solid var(--color-border-sand);
		box-shadow: var(--shadow-card);
		display: grid;
		gap: 0.55rem;
	}

	.steps-preview header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(113, 88, 62, 0.14);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	:lang(ar) .steps-preview header {
		font-family: var(--font-arabic);
		letter-spacing: 0;
		text-transform: none;
	}

	.steps-preview header span {
		color: var(--color-slate);
	}

	.steps-preview .row {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.75rem;
		background: var(--surface-page);
		font-size: 0.92rem;
	}

	.steps-preview-board .row {
		grid-template-columns: 1fr auto;
	}

	.steps-preview-board .row span {
		color: var(--color-success);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	:lang(ar) .steps-preview-board .row span {
		font-family: var(--font-arabic);
