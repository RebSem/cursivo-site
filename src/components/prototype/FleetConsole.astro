---
import Mark from './Mark.astro';

interface Props {
  locale?: 'ru' | 'en';
}

const { locale = 'ru' } = Astro.props;
const ru = locale === 'ru';
const copy = {
  overview: ru ? 'Обзор автопарка' : 'Fleet overview',
  workspace: ru ? 'Ваш рабочий день. Всё на месте.' : 'Your working day. All in one place.',
  fleet: ru ? 'Автопарк' : 'Fleet',
  requests: ru ? 'Заявки' : 'Requests',
  messages: ru ? 'Сообщения' : 'Messages',
  total: ru ? 'автомобиля' : 'vehicles',
  available: ru ? 'доступны' : 'available',
  rented: ru ? 'в аренде' : 'on rental',
  date: ru ? 'Период аренды' : 'Rental period',
  vehicle: ru ? 'Автомобиль' : 'Vehicle',
  status: ru ? 'Доступность' : 'Availability',
  location: ru ? 'Локация' : 'Location',
  price: ru ? 'В сутки' : 'Per day',
  free: ru ? 'Доступен' : 'Available',
  occupied: ru ? 'В аренде' : 'On rental',
  demo: ru ? 'Демо-данные' : 'Demo data',
  synced: ru ? 'Концепт MCP: общий календарь для команды и агентов' : 'MCP concept: one calendar for your team and agents',
  carCount: ru ? '3 из 24 автомобилей' : '3 of 24 vehicles',
  periods: ru ? ['14–17 сент. 2026', '18–21 сент. 2026', '22–25 сент. 2026'] : ['Sep 14–17, 2026', 'Sep 18–21, 2026', 'Sep 22–25, 2026'],
};
const cars = [
  { key: 'porsche', name: 'Porsche 911 Carrera', category: ru ? 'Спорткар · 2025' : 'Sports car · 2025', location: 'Dubai Marina', price: '1,200', rented: false },
  { key: 'mercedes', name: 'Mercedes-Benz G 63', category: ru ? 'Внедорожник · 2025' : 'SUV · 2025', location: 'Downtown', price: '1,600', rented: true },
  { key: 'range', name: 'Range Rover Sport', category: ru ? 'Внедорожник · 2025' : 'SUV · 2025', location: 'Dubai Marina', price: '950', rented: false },
];
const bookings = [
  { initials: 'AK', name: 'Alex K.', car: 'Porsche 911 Carrera', source: ru ? 'ИИ-агент · MCP' : 'AI agent · MCP', state: ru ? 'На согласовании' : 'Awaiting approval', stateClass: 'pending', price: '3,600' },
  { initials: 'MS', name: 'Maria S.', car: 'Mercedes-Benz G 63', source: 'WhatsApp', state: ru ? 'Подтверждена' : 'Confirmed', stateClass: 'confirmed', price: '4,800' },
  { initials: 'JD', name: 'James D.', car: 'Range Rover Sport', source: ru ? 'Сайт' : 'Website', state: ru ? 'Подтверждена' : 'Confirmed', stateClass: 'confirmed', price: '2,850' },
];
---

<section class="fleet-console" data-fleet-console data-locale={locale} aria-label={ru ? 'Интерактивный прототип Cursivo. Демо-данные.' : 'Interactive Cursivo prototype. Demo data.'}>
  <aside class="console-sidebar" aria-label={ru ? 'Рабочее пространство' : 'Workspace'}>
    <div class="console-brand"><Mark size={22} /><span>cursivo</span></div>
    <div class="workspace-name"><span class="workspace-avatar">M</span><div>Marina Rentals<small>{ru ? 'Рабочее пространство' : 'Workspace'}</small></div></div>
    <div class="sidebar-label">{ru ? 'УПРАВЛЕНИЕ' : 'WORKSPACE'}</div>
    <div class="sidebar-item is-current"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="3" width="5" height="5" rx="1.4"/><rect x="12" y="3" width="5" height="5" rx="1.4"/><rect x="3" y="12" width="5" height="5" rx="1.4"/><rect x="12" y="12" width="5" height="5" rx="1.4"/></svg>{ru ? 'Обзор' : 'Overview'}</div>
    <div class="sidebar-item"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="2"/><path d="M6.5 2.5v4M13.5 2.5v4M3 9h14"/></svg>{ru ? 'Календарь' : 'Calendar'}</div>
    <div class="sidebar-item"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="6.5" r="3"/><path d="M4 17v-1a6 6 0 0 1 12 0v1"/></svg>{ru ? 'Клиенты' : 'Customers'}</div>
    <div class="sidebar-item"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16V9M10 16V4M16 16v-5" stroke-linecap="round"/></svg>{ru ? 'Аналитика' : 'Reports'}</div>
    <div class="sidebar-bottom"><span class="team-avatar">AM</span><div>Anna M.<small>{ru ? 'Менеджер' : 'Manager'}</small></div><span class="online-dot" aria-label={ru ? 'В сети' : 'Online'}></span></div>
  </aside>

  <div class="console-main">
    <header class="console-heading">
      <div><h3>{copy.overview}</h3><p>{copy.workspace}</p></div>
      <label class="date-control"><span class="sr-only">{copy.date}</span><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="2"/><path d="M6.5 2.5v4M13.5 2.5v4M3 9h14"/></svg><select data-fleet-period>{copy.periods.map((period, index) => <option value={index}>{period}</option>)}</select><svg class="select-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg></label>
    </header>

    <div class="fleet-metrics" aria-live="polite" aria-atomic="true">
      <span><strong>24</strong>{copy.total}</span><span><i class="metric-dot available-dot"></i><strong data-available-count>18</strong>{copy.available}</span><span><i class="metric-dot rented-dot"></i><strong data-rented-count>6</strong>{copy.rented}</span>
    </div>

    <div class="console-tabs" role="tablist" aria-label={ru ? 'Разделы демо' : 'Demo sections'}>
      <button id={`fleet-tab-${locale}`} type="button" role="tab" aria-selected="true" aria-controls={`fleet-panel-${locale}`} tabindex="0" data-console-tab="fleet">{copy.fleet}<span>24</span></button>
      <button id={`requests-tab-${locale}`} type="button" role="tab" aria-selected="false" aria-controls={`requests-panel-${locale}`} tabindex="-1" data-console-tab="requests">{copy.requests}<span>3</span></button>
      <button id={`messages-tab-${locale}`} type="button" role="tab" aria-selected="false" aria-controls={`messages-panel-${locale}`} tabindex="-1" data-console-tab="messages">{copy.messages}<span class="unread-dot"></span></button>
      <span class="demo-label">{copy.demo}</span>
    </div>

    <div id={`fleet-panel-${locale}`} class="console-panel" role="tabpanel" aria-labelledby={`fleet-tab-${locale}`} data-console-panel="fleet" tabindex="0">
      <table class="fleet-table">
        <thead><tr><th>{copy.vehicle}</th><th>{copy.status}</th><th class="location-column">{copy.location}</th><th class="price-column">{copy.price}</th></tr></thead>
        <tbody>{cars.map((car, index) => <tr data-car-row={index}>
          <td><div class="vehicle-cell"><svg class={`car-illustration car-${car.key}`} viewBox="0 0 240 110" fill="none" aria-hidden="true">
            <ellipse cx="120" cy="91" rx="105" ry="5" fill="oklch(0.2 0.005 50 / 0.06)"/>
            {car.key === 'porsche' ? <>
              <path d="M18 75 23 62 42 57 76 33Q87 26 103 27L127 30Q147 37 166 53L208 60Q224 62 227 74L224 83H18Z" fill="oklch(0.83 0.008 82)" stroke="oklch(0.68 0.008 82)" stroke-width="1.4"/>
              <path d="m52 56 30-22q9-5 20-4l21 3q20 7 34 21Z" fill="oklch(0.3 0.013 245)"/>
              <path d="m61 53 23-16q8-4 15-4l-5 20Zm39 0 5-20 17 3q15 5 27 16Z" fill="oklch(0.45 0.014 245)"/>
              <path d="m94 57-4 25m76-27 9 28M20 73h205M133 62h12" stroke="oklch(0.67 0.006 82)" stroke-width="1.2"/>
              <path d="m204 64 15 3 4 6-20-3Z" fill="oklch(0.98 0.005 83)"/><path d="M21 64h12l-4 6H19" fill="oklch(0.56 0.15 30)"/><path d="m42 57 14 1M108 57h9" stroke="oklch(0.54 0.005 82)" stroke-width="2" stroke-linecap="round"/>
            </> : car.key === 'mercedes' ? <>
              <path d="M21 78V40q0-4 4-4h17V24h107l19 28 43 5q10 2 12 12l2 15H21Z" fill="oklch(0.29 0.005 82)" stroke="oklch(0.21 0.005 82)" stroke-width="1.4"/>
              <path d="M46 29h94l16 23H46Z" fill="oklch(0.41 0.015 245)"/><path d="M82 27v28m42-28v28M47 57v26M87 56v27m43-27v27" stroke="oklch(0.19 0.005 82)" stroke-width="2"/>
              <path d="M44 56h119M25 77h194M96 61h9m33 0h9" stroke="oklch(0.45 0.005 82)" stroke-width="1.4"/><rect x="18" y="48" width="9" height="28" rx="3" fill="oklch(0.21 0.005 82)"/><path d="m212 61 9 4 1 7h-11Z" fill="oklch(0.92 0.01 80)"/><path d="M26 63h4v9h-4" fill="oklch(0.59 0.16 28)"/><path d="m151 52 8 1v5h-8" fill="oklch(0.21 0.005 82)"/>
            </> : <>
              <path d="m19 77 6-27 37-6 21-22h85l21 31 25 6q9 2 10 12l-1 13H19Z" fill="oklch(0.59 0.03 123)" stroke="oklch(0.45 0.025 123)" stroke-width="1.4"/>
              <path d="m68 45 18-19h78l17 25-113-3Z" fill="oklch(0.28 0.013 245)"/><path d="m78 43 11-14h24v16Zm41 2V29h41l12 18Z" fill="oklch(0.41 0.014 245)"/><path d="M113 51v31M177 53l4 29M26 63h191M23 78h198" stroke="oklch(0.44 0.025 123)" stroke-width="1.3"/>
              <path d="m207 61 13 4 1 6h-17Z" fill="oklch(0.96 0.007 80)"/><path d="m24 54 10-2-1 7-11 2Z" fill="oklch(0.58 0.16 28)"/><path d="M94 57h8m49 0h8" stroke="oklch(0.26 0.015 123)" stroke-width="2" stroke-linecap="round"/><path d="m164 49 9 1v6h-9" fill="oklch(0.25 0.009 123)"/>
            </>}
            {[58, 187].map((x) => <g><circle cx={x} cy="81" r="18" fill="oklch(0.21 0.006 50)"/><circle cx={x} cy="81" r="12" fill="oklch(0.57 0.008 82)"/><circle cx={x} cy="81" r="9.5" fill="oklch(0.32 0.008 82)"/>{[0, 60, 120].map((angle) => <path d={`M${x} 72v18`} stroke="oklch(0.75 0.006 82)" stroke-width="2" transform={`rotate(${angle} ${x} 81)`}/>)}<circle cx={x} cy="81" r="3" fill="oklch(0.68 0.008 82)"/></g>)}
          </svg><div class="vehicle-name"><strong>{car.name}</strong><span>{car.category}</span></div></div></td>
          <td><span class:list={['vehicle-status', { 'is-rented': car.rented }]} data-car-status><i></i><span data-status-label>{car.rented ? copy.occupied : copy.free}</span></span></td>
          <td class="location-column">{car.location}</td><td class="price-column"><strong>{car.price}</strong><span> AED</span></td>
        </tr>)}</tbody>
      </table>
      <div class="panel-bottom"><span>{copy.carCount}</span><span class="calendar-note"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 8 2.5 2.5L12 5"/></svg>{ru ? 'Доступность обновляется по датам' : 'Availability follows selected dates'}</span></div>
    </div>

    <div id={`requests-panel-${locale}`} class="console-panel requests-panel" role="tabpanel" aria-labelledby={`requests-tab-${locale}`} data-console-panel="requests" tabindex="0" hidden>
      <div class="requests-heading"><span>{ru ? 'Клиент и автомобиль' : 'Customer and vehicle'}</span><span>{ru ? 'Канал' : 'Channel'}</span><span>{ru ? 'Статус заявки' : 'Request status'}</span><span>{ru ? 'За 3 дня' : 'For 3 days'}</span></div>
      {bookings.map((booking) => <div class="request-row"><div class="request-customer"><span class="customer-avatar">{booking.initials}</span><div><strong>{booking.name}</strong><small>{booking.car}</small></div></div><span class:list={['request-source', { 'agent-source': booking.source.includes('MCP') }]}>{booking.source}</span><span class={`request-state ${booking.stateClass}`}>{booking.state}</span><span class="request-total"><strong>{booking.price}</strong> AED</span></div>)}
      <div class="panel-bottom"><span>{ru ? 'Все обращения в одном окне' : 'Every request in one place'}</span><span class="calendar-note">{ru ? 'Пример работы с заявками' : 'Sample requests'}</span></div>
    </div>

    <div id={`messages-panel-${locale}`} class="console-panel messages-panel" role="tabpanel" aria-labelledby={`messages-tab-${locale}`} data-console-panel="messages" tabindex="0" hidden>
      <div class="conversation-heading"><span class="customer-avatar">AK</span><div><strong>Alex K.</strong><small>{ru ? 'Запрос через ИИ-агента · MCP' : 'Request via AI agent · MCP'}</small></div><span class="conversation-time">10:42</span></div>
      <div class="conversation"><div class="message incoming"><span class="message-author">{ru ? 'ИИ-агент клиента' : 'Customer’s AI agent'}</span><p>{ru ? 'Нужен спорткар в Dubai Marina на 14–17 сентября. Какие машины свободны?' : 'Looking for a sports car in Dubai Marina, September 14–17. What’s available?'}</p></div><div class="message outgoing"><span class="message-author">Cursivo</span><p>{ru ? 'Porsche 911 Carrera доступен. 1,200 AED в сутки. Условия и актуальная доступность переданы агенту.' : 'Porsche 911 Carrera is available at 1,200 AED per day. Terms and current availability shared with the agent.'}</p></div></div>
      <div class="conversation-notice"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 8 2.5 2.5L12 5"/></svg>{ru ? 'Пример сценария MCP. Решение о бронировании остаётся за вами.' : 'MCP scenario preview. You stay in control of the booking.'}</div>
    </div>

    <footer class="console-footer"><span class="connected-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m5.5 10.5-1 1a2.8 2.8 0 0 1-4-4l3-3a2.8 2.8 0 0 1 4 0m1 1 1-1a2.8 2.8 0 0 1 4 4l-3 3a2.8 2.8 0 0 1-4 0M5 9l4-4" transform="translate(1 1)"/></svg></span><span>{copy.synced}</span><span class="footer-protocol">MCP</span></footer>
  </div>
</section>

<style>
  .fleet-console { --console-ink: oklch(0.25 0.006 70); --console-muted: oklch(0.55 0.008 70); --console-line: oklch(0.91 0.005 80); --console-accent: oklch(0.58 0.15 43); width: 100%; display: grid; grid-template-columns: 160px minmax(0, 1fr); overflow: hidden; border: 1px solid oklch(0.86 0.005 80); border-radius: 13px; background: oklch(0.997 0.002 80); color: var(--console-ink); font-family: inherit; font-size: 11px; font-weight: 500; line-height: 1.5; text-align: left; box-shadow: 0 2px 6px oklch(0.25 0.008 70 / 0.02); }
  .fleet-console * { box-sizing: border-box; }
  .fleet-console svg { flex-shrink: 0; }
  .fleet-console button, .fleet-console select { font-family: inherit; }
  .fleet-console button:focus-visible, .fleet-console select:focus-visible, .console-panel:focus-visible { outline: 2px solid var(--console-accent); outline-offset: 4px; }
  .console-sidebar { padding: 23px 13px 17px; display: flex; flex-direction: column; background: oklch(0.973 0.004 80); border-right: 1px solid var(--console-line); }
  .console-brand { display: flex; align-items: center; gap: 7px; padding-left: 6px; font-size: 20px; font-weight: 750; letter-spacing: -1px; }
  .workspace-name { display: flex; align-items: center; gap: 7px; margin: 26px 4px 26px; font-size: 9px; font-weight: 700; white-space: nowrap; }
  .workspace-avatar { width: 26px; height: 26px; display: grid; place-items: center; border: 1px solid oklch(0.88 0.005 80); background: oklch(0.99 0.003 80); border-radius: 7px; font-size: 11px; }
  .workspace-name small, .sidebar-bottom small { display: block; margin-top: 1px; font-size: 8px; color: var(--console-muted); font-weight: 500; }
  .sidebar-label { margin: 0 9px 10px; font-size: 8px; font-weight: 650; letter-spacing: 1.1px; color: oklch(0.59 0.007 70); }
  .sidebar-item { height: 35px; display: flex; align-items: center; gap: 9px; padding: 0 9px; margin-bottom: 3px; color: var(--console-muted); font-size: 11px; }
  .sidebar-item svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.4; }
  .sidebar-item.is-current { border: 1px solid oklch(0.9 0.006 80); border-radius: 6px; color: var(--console-ink); background: oklch(0.997 0.002 80); box-shadow: 0 1px 2px oklch(0.2 0.006 80 / 0.025); }
  .sidebar-bottom { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 22px 5px 0; font-size: 10px; }
  .team-avatar { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 50%; background: oklch(0.87 0.035 65); color: oklch(0.4 0.045 65); font-size: 8px; font-weight: 700; }
  .online-dot { width: 5px; height: 5px; border-radius: 50%; background: oklch(0.6 0.1 155); margin-left: auto; }
  .console-main { min-width: 0; padding: 25px 26px 0; }
  .console-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .console-heading h3 { margin: 0; font-size: 19px; line-height: 1.3; font-weight: 650; letter-spacing: -0.6px; }
  .console-heading p { margin: 5px 0 0; color: var(--console-muted); font-size: 11px; }
  .date-control { display: flex; align-items: center; position: relative; height: 36px; border: 1px solid var(--console-line); border-radius: 6px; padding-left: 9px; gap: 6px; background: oklch(0.995 0.002 80); }
  .date-control > svg:first-of-type { width: 13px; height: 13px; stroke: var(--console-muted); stroke-width: 1.3; }
  .date-control select { appearance: none; cursor: pointer; padding: 8px 25px 8px 0; border: 0; border-radius: 5px; background: transparent; color: var(--console-ink); font-size: 10px; font-weight: 600; }
  .select-chevron { width: 10px; height: 10px; position: absolute; right: 8px; pointer-events: none; stroke: var(--console-muted); stroke-width: 1.5; }
  .fleet-metrics { display: flex; align-items: center; gap: 22px; margin: 26px 0 23px; }
  .fleet-metrics > span { display: flex; align-items: center; gap: 6px; color: var(--console-muted); font-size: 11px; white-space: nowrap; }
  .fleet-metrics strong { font-size: 23px; font-weight: 600; letter-spacing: -0.7px; color: var(--console-ink); line-height: 1; }
  .metric-dot { width: 5px; height: 5px; border-radius: 50%; margin-right: 1px; }
  .available-dot { background: oklch(0.61 0.09 157); }
  .rented-dot { background: oklch(0.77 0.007 70); }
  .console-tabs { display: flex; align-items: stretch; gap: 21px; height: 42px; border-bottom: 1px solid var(--console-line); }
  .console-tabs button { position: relative; display: flex; align-items: center; gap: 6px; background: transparent; border: 0; padding: 0 0 12px; cursor: pointer; font-size: 12px; font-weight: 600; color: var(--console-muted); white-space: nowrap; transition: color 160ms ease-out; }
  .console-tabs button:hover { color: var(--console-ink); }
  .console-tabs button[aria-selected='true'] { color: var(--console-ink); }
  .console-tabs button[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--console-accent); }
  .console-tabs button > span:not(.unread-dot) { padding: 0 4px; border-radius: 4px; color: var(--console-muted); background: oklch(0.956 0.003 80); font-size: 9px; }
  .unread-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--console-accent); }
  .demo-label { margin-left: auto; padding-top: 1px; color: oklch(0.59 0.008 70); font-size: 9px; }
  .console-panel { min-height: 285px; }
  .console-panel[hidden] { display: none; }
  .fleet-table { width: 100%; border-collapse: collapse; table-layout: auto; }
  .fleet-table th { font-size: 10px; font-weight: 500; height: 35px; color: var(--console-muted); text-align: left; white-space: nowrap; }
  .fleet-table td { height: 70px; padding: 0 8px 0 0; border-top: 1px solid oklch(0.95 0.003 80); }
  .fleet-table th:first-child { padding-left: 2px; }
  .vehicle-cell { display: flex; align-items: center; gap: 9px; }
  .car-illustration { width: 110px; height: 56px; }
  .vehicle-name { display: flex; flex-direction: column; gap: 3px; }
  .vehicle-name strong { font-size: 12px; font-weight: 650; white-space: nowrap; }
  .vehicle-name > span { font-size: 10px; color: var(--console-muted); white-space: nowrap; }
  .vehicle-status { display: inline-flex; align-items: center; gap: 4px; padding: 3px 6px; border-radius: 4px; background: oklch(0.965 0.017 155); color: oklch(0.44 0.073 155); font-size: 10px; font-weight: 600; white-space: nowrap; }
  .vehicle-status i { width: 3px; height: 3px; background: currentColor; border-radius: 50%; }
  .vehicle-status.is-rented { color: oklch(0.55 0.008 70); background: oklch(0.953 0.004 70); }
  .fleet-table .location-column { font-size: 10px; color: var(--console-muted); white-space: nowrap; }
  .fleet-table .price-column { text-align: right; white-space: nowrap; padding-right: 0; }
  .price-column strong { font-size: 12px; font-weight: 600; }
  .price-column span { color: var(--console-muted); font-size: 9px; }
  .panel-bottom { height: 40px; display: flex; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid oklch(0.94 0.003 80); color: var(--console-muted); font-size: 9px; }
  .calendar-note { display: inline-flex; align-items: center; gap: 4px; }
  .calendar-note svg { width: 12px; height: 12px; stroke: oklch(0.52 0.07 155); stroke-width: 1.4; }
  .console-footer { display: flex; align-items: center; gap: 7px; height: 40px; margin: 0 -26px; padding: 0 26px; background: oklch(0.98 0.003 80); border-top: 1px solid var(--console-line); color: var(--console-muted); font-size: 10px; }
  .connected-icon { display: flex; color: oklch(0.49 0.05 155); }
  .connected-icon svg { width: 13px; height: 13px; stroke: currentColor; stroke-width: 1.2; }
  .footer-protocol { margin-left: auto; padding: 1px 4px; border: 1px solid oklch(0.86 0.004 80); border-radius: 3px; font-family: ui-monospace, monospace; font-size: 8px; letter-spacing: 0.5px; color: var(--console-ink); }
  .requests-heading, .request-row { display: grid; grid-template-columns: 1.8fr 1fr 1.2fr 0.7fr; align-items: center; gap: 9px; }
  .requests-heading { height: 35px; color: var(--console-muted); font-size: 10px; }
  .requests-heading > span:last-child { text-align: right; }
