<script>
  document.querySelectorAll<HTMLElement>('[data-fleet-console]').forEach((consoleElement) => {
    if (consoleElement.dataset.initialized === 'true') return;
    consoleElement.dataset.initialized = 'true';
    const tabs = Array.from(consoleElement.querySelectorAll<HTMLButtonElement>('[data-console-tab]'));
    const panels = Array.from(consoleElement.querySelectorAll<HTMLElement>('[data-console-panel]'));
    const activate = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => { const selected = item === tab; item.setAttribute('aria-selected', String(selected)); item.tabIndex = selected ? 0 : -1; });
      panels.forEach((panel) => { panel.hidden = panel.dataset.consolePanel !== tab.dataset.consoleTab; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        const next = tabs[nextIndex];
        if (next) { activate(next); next.focus(); }
      });
    });
    const periods = [{ available: 18, rented: 6, states: [false, true, false] }, { available: 16, rented: 8, states: [true, false, false] }, { available: 20, rented: 4, states: [false, false, true] }];
    consoleElement.querySelector<HTMLSelectElement>('[data-fleet-period]')?.addEventListener('change', (event) => {
      const period = periods[Number((event.target as HTMLSelectElement).value)];
      if (!period) return;
      const availableCount = consoleElement.querySelector('[data-available-count]');
      const rentedCount = consoleElement.querySelector('[data-rented-count]');
      if (availableCount) availableCount.textContent = String(period.available);
      if (rentedCount) rentedCount.textContent = String(period.rented);
      const isRu = consoleElement.dataset.locale === 'ru';
      consoleElement.querySelectorAll<HTMLElement>('[data-car-row]').forEach((row, index) => {
        const rented = period.states[index];
        row.querySelector('[data-car-status]')?.classList.toggle('is-rented', rented);
        const label = row.querySelector('[data-status-label]');
        if (label) label.textContent = rented ? (isRu ? 'В аренде' : 'On rental') : (isRu ? 'Доступен' : 'Available');
      });
      const fleetTab = tabs.find((tab) => tab.dataset.consoleTab === 'fleet');
      if (fleetTab) activate(fleetTab);
    });
  });
</script>
