---
interface Props {
  locale?: 'ru' | 'en';
}

const { locale = 'ru' } = Astro.props;
const copy = locale === 'ru' ? {
  title: 'Личный ИИ-агент',
  demo: 'Демо',
  prompt: 'Найди SUV в Дубае на 14–17 сентября. До 900 AED в день.',
  availability: 'Наличие',
  comparison: 'Сравнение',
  booking: 'Бронь',
  found: 'Есть два подходящих автомобиля.',
  dates: '14–17 сентября 2026 · 3 дня',
  legend: 'Выберите автомобиль для демо-бронирования',
  detail: 'SUV · автомат · 5 мест',
  day: '/ день',
  totalDays: 'за 3 дня',
  prepare: 'Подготовить бронь',
  review: 'Всё готово. Проверьте детали.',
  location: 'Дубай',
  rental: 'Период аренды',
  shortDates: '14–17 сентября 2026',
  rate: 'Стоимость в день',
  total: 'Итого за 3 дня',
  confirm: 'Подтвердить в демо',
  back: 'Назад к выбору',
  success: 'Демо-бронь создана',
  successNote: 'Это пример. Машина не забронирована.',
  restart: 'Попробовать ещё раз',
  connection: 'Демонстрация MCP',
  footer: 'Пример сценария',
  initialStatus: 'Найдены два автомобиля. Выберите подходящий.',
  reviewStatus: 'Проверьте детали демо-брони перед подтверждением.',
} : {
  title: 'Personal AI agent',
  demo: 'Demo',
  prompt: 'Find an SUV in Dubai for September 14–17. Up to 900 AED per day.',
  availability: 'Availability',
  comparison: 'Compare',
  booking: 'Book',
  found: 'Two matching cars are available.',
  dates: 'September 14–17, 2026 · 3 days',
  legend: 'Choose a car for the demo booking',
  detail: 'SUV · automatic · 5 seats',
  day: '/ day',
  totalDays: 'for 3 days',
  prepare: 'Prepare booking',
  review: 'Ready. Let’s check the details.',
  location: 'Dubai',
  rental: 'Rental dates',
  shortDates: 'September 14–17, 2026',
  rate: 'Daily rate',
  total: 'Total for 3 days',
  confirm: 'Confirm demo booking',
  back: 'Back to cars',
  success: 'Demo booking created',
  successNote: 'This is an example. No car has been booked.',
  restart: 'Try again',
  connection: 'MCP demonstration',
  footer: 'Example scenario',
  initialStatus: 'Two cars found. Choose your preferred car.',
  reviewStatus: 'Check the demo booking details before confirming.',
};
const instanceId = `agent-${Math.random().toString(36).slice(2, 10)}`;
const vehicles = [
  { id: 'glc', name: 'Mercedes GLC', rate: 650, total: 1950 },
  { id: 'x3', name: 'BMW X3', rate: 590, total: 1770 },
];
const formatPrice = (price: number) => new Intl.NumberFormat(locale === 'ru' ? 'ru-RU' : 'en-US').format(price);
---

<cursivo-agent-booking
  class="agent-booking"
  data-copy={JSON.stringify(copy)}
  data-locale={locale}
  data-state="choose"
>
  <header class="agent-header">
    <span class="agent-avatar" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v18M3 12h18M5.65 5.65l12.7 12.7M5.65 18.35l12.7-12.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
    </span>
    <span class="agent-title">{copy.title}</span>
    <span class="demo-badge">{copy.demo}</span>
  </header>

  <div class="agent-conversation">
    <div class="customer-message"><p>{copy.prompt}</p></div>

    <ol class="tool-steps" aria-label={copy.connection}>
      <li class="is-complete" data-progress="availability"><span class="step-dot" aria-hidden="true"></span>{copy.availability}</li>
      <li aria-hidden="true" class="step-arrow">→</li>
      <li class="is-current" data-progress="comparison" aria-current="step"><span class="step-dot" aria-hidden="true"></span>{copy.comparison}</li>
      <li aria-hidden="true" class="step-arrow">→</li>
      <li data-progress="booking"><span class="step-dot" aria-hidden="true"></span>{copy.booking}</li>
    </ol>

    <div class="booking-panel choose-panel" data-panel="choose">
      <p class="agent-response">{copy.found}</p>
      <p class="rental-dates">{copy.dates}</p>
      <fieldset class="vehicle-options">
        <legend class="sr-only">{copy.legend}</legend>
        {vehicles.map((vehicle, index) => (
          <label class="vehicle-option">
            <input type="radio" name={`${instanceId}-vehicle`} value={vehicle.id} data-name={vehicle.name} data-rate={vehicle.rate} data-total={vehicle.total} checked={index === 0} />
            <span class="vehicle-row">
              <span class="radio-mark" aria-hidden="true"></span>
              <span class="vehicle-details"><strong>{vehicle.name}</strong><span>{copy.detail}</span></span>
              <span class="vehicle-price"><strong>{vehicle.rate} <span>AED {copy.day}</span></strong><span>{formatPrice(vehicle.total)} AED {copy.totalDays}</span></span>
            </span>
          </label>
        ))}
      </fieldset>
      <button class="agent-action" type="button" data-action="prepare">{copy.prepare}<span aria-hidden="true">↗</span></button>
    </div>

    <div class="booking-panel review-panel" data-panel="review" hidden>
      <h4 class="agent-response" data-review-heading tabindex="-1">{copy.review}</h4>
      <div class="booking-car"><strong data-selected-name>Mercedes GLC</strong><span>{copy.location} · SUV</span></div>
      <dl class="booking-summary">
        <div><dt>{copy.rental}</dt><dd>{copy.shortDates}</dd></div>
        <div><dt>{copy.rate}</dt><dd><span data-selected-rate>650</span> AED</dd></div>
        <div class="summary-total"><dt>{copy.total}</dt><dd><span data-selected-total>{formatPrice(1950)}</span> AED</dd></div>
      </dl>
      <button class="agent-action" type="button" data-action="confirm">{copy.confirm}<span aria-hidden="true">↗</span></button>
      <button class="agent-back" type="button" data-action="back">{copy.back}</button>
    </div>

    <div class="booking-panel success-panel" data-panel="success" hidden>
      <span class="success-mark" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="m9 16 4.5 4.5L23 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      <h4 data-success-heading tabindex="-1">{copy.success}</h4>
      <p class="success-car"><span data-selected-name>Mercedes GLC</span> · <span data-selected-total>{formatPrice(1950)}</span> AED</p>
      <p class="success-dates">{copy.shortDates}</p>
      <p class="success-note">{copy.successNote}</p>
      <button class="agent-action reset-action" type="button" data-action="reset">{copy.restart}<span aria-hidden="true">↻</span></button>
    </div>
  </div>

  <footer class="agent-footer"><span><i aria-hidden="true"></i>{copy.connection}</span><span>{copy.footer}</span></footer>
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-status>{copy.initialStatus}</p>
</cursivo-agent-booking>

<script>
  class CursivoAgentBooking extends HTMLElement {
    private initialized = false;

    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      const copy = JSON.parse(this.dataset.copy || '{}');
      const formatter = new Intl.NumberFormat(this.dataset.locale === 'ru' ? 'ru-RU' : 'en-US');
      const status = this.querySelector<HTMLElement>('[data-status]');

      const show = (state: 'choose' | 'review' | 'success') => {
        this.dataset.state = state;
        this.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== state;
        });
        const comparing = this.querySelector<HTMLElement>('[data-progress="comparison"]');
        const booking = this.querySelector<HTMLElement>('[data-progress="booking"]');
        comparing?.classList.toggle('is-current', state === 'choose');
        comparing?.classList.toggle('is-complete', state !== 'choose');
        booking?.classList.toggle('is-current', state === 'review');
        booking?.classList.toggle('is-complete', state === 'success');
        comparing?.removeAttribute('aria-current');
        booking?.removeAttribute('aria-current');
        if (state === 'choose') comparing?.setAttribute('aria-current', 'step');
        if (state === 'review') booking?.setAttribute('aria-current', 'step');
      };

      this.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const action = event.target.closest<HTMLButtonElement>('[data-action]')?.dataset.action;
        if (!action) return;

        if (action === 'prepare') {
          const vehicle = this.querySelector<HTMLInputElement>('input[type="radio"]:checked');
          if (!vehicle) return;
          this.querySelectorAll<HTMLElement>('[data-selected-name]').forEach((node) => { node.textContent = vehicle.dataset.name || ''; });
          this.querySelectorAll<HTMLElement>('[data-selected-rate]').forEach((node) => { node.textContent = formatter.format(Number(vehicle.dataset.rate)); });
          this.querySelectorAll<HTMLElement>('[data-selected-total]').forEach((node) => { node.textContent = formatter.format(Number(vehicle.dataset.total)); });
          show('review');
          if (status) status.textContent = copy.reviewStatus;
          this.querySelector<HTMLElement>('[data-review-heading]')?.focus({ preventScroll: true });
        } else if (action === 'confirm') {
          show('success');
          if (status) status.textContent = `${copy.success}. ${copy.successNote}`;
          this.querySelector<HTMLElement>('[data-success-heading]')?.focus({ preventScroll: true });
        } else if (action === 'back' || action === 'reset') {
          if (action === 'reset') {
            const firstVehicle = this.querySelector<HTMLInputElement>('input[type="radio"]');
            if (firstVehicle) firstVehicle.checked = true;
          }
          show('choose');
          if (status) status.textContent = copy.initialStatus;
          this.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.focus({ preventScroll: true });
        }
      });
    }
  }

  if (!customElements.get('cursivo-agent-booking')) {
    customElements.define('cursivo-agent-booking', CursivoAgentBooking);
  }
</script>

<style>
  .agent-booking { --agent-ink: oklch(0.95 0.011 80); --agent-muted: oklch(0.72 0.013 255); --agent-line: oklch(0.98 0.005 80 / 0.12); --agent-accent: oklch(0.77 0.092 44); display: flex; flex-direction: column; width: 100%; max-width: 540px; min-width: 0; overflow: hidden; color: var(--agent-ink); background: oklch(0.22 0.01 250); border: 1px solid var(--agent-line); border-radius: 22px; box-shadow: 0 24px 60px oklch(0.1 0.005 250 / 0.2); font-family: inherit; font-size: 12px; line-height: 1.5; text-align: left; }
  .agent-booking *, .agent-booking *::before, .agent-booking *::after { box-sizing: border-box; }
  .agent-booking p, .agent-booking h4 { margin: 0; }
  .agent-booking [hidden] { display: none !important; }
  .agent-header { display: flex; align-items: center; gap: 10px; padding: 17px 24px; border-bottom: 1px solid var(--agent-line); }
  .agent-avatar { display: grid; place-items: center; width: 25px; height: 25px; color: var(--agent-accent); }
  .agent-avatar svg { width: 24px; height: 24px; }
  .agent-title { font-size: 13px; font-weight: 650; letter-spacing: -0.02em; }
  .demo-badge { margin-left: auto; padding: 3px 8px; color: var(--agent-muted); border: 1px solid var(--agent-line); border-radius: 5px; font-size: 10px; }
  .agent-conversation { flex: 1; padding: 22px 24px 20px; }
  .customer-message { width: fit-content; max-width: 93%; margin-left: auto; padding: 11px 14px; background: oklch(0.3 0.012 250); border-radius: 14px 14px 4px 14px; }
  .customer-message p { font-size: 12px; line-height: 1.65; }
  .tool-steps { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 0; margin: 21px 0 17px; list-style: none; color: var(--agent-muted); font-size: 10px; }
  .tool-steps li { display: flex; align-items: center; gap: 5px; }
  .tool-steps .step-arrow { color: oklch(0.54 0.012 250); }
  .step-dot { width: 5px; height: 5px; border-radius: 50%; background: oklch(0.46 0.012 250); }
  .is-complete { color: oklch(0.79 0.055 159); }
  .is-complete .step-dot { background: oklch(0.75 0.086 159); }
  .is-current { color: var(--agent-ink); }
  .is-current .step-dot { background: var(--agent-accent); box-shadow: 0 0 0 3px oklch(0.77 0.092 44 / 0.12); }
  .booking-panel { min-height: 230px; }
  .agent-response { color: var(--agent-ink); font-size: 12px; font-weight: 550; line-height: 1.6; }
  .rental-dates { margin-top: 3px !important; color: var(--agent-muted); font-size: 10px; }
  .vehicle-options { padding: 0; margin: 12px 0 14px; border: 0; }
  .vehicle-option { position: relative; display: block; cursor: pointer; }
  .vehicle-option + .vehicle-option { margin-top: 3px; }
  .vehicle-option input { position: absolute; inset: 0 auto auto 0; width: 1px; height: 1px; opacity: 0; }
  .vehicle-row { display: flex; align-items: center; gap: 10px; min-height: 59px; padding: 10px; border: 1px solid transparent; border-radius: 9px; transition: background 160ms ease-out, border-color 160ms ease-out; }
  .vehicle-option:hover .vehicle-row { background: oklch(0.3 0.012 250 / 0.5); }
  .vehicle-option input:checked + .vehicle-row { background: oklch(0.28 0.012 250); border-color: oklch(0.6 0.048 50 / 0.44); }
  .vehicle-option input:focus-visible + .vehicle-row { outline: 2px solid var(--agent-accent); outline-offset: 3px; }
  .radio-mark { flex: 0 0 12px; width: 12px; height: 12px; border: 1px solid oklch(0.58 0.013 250); border-radius: 50%; }
  input:checked + .vehicle-row .radio-mark { border: 3px solid var(--agent-accent); background: oklch(0.22 0.01 250); }
  .vehicle-details, .vehicle-price { display: flex; flex-direction: column; gap: 2px; }
  .vehicle-details strong { font-size: 12px; font-weight: 650; letter-spacing: -0.015em; }
  .vehicle-details > span, .vehicle-price > span { color: var(--agent-muted); font-size: 10px; }
  .vehicle-price { margin-left: auto; text-align: right; white-space: nowrap; }
  .vehicle-price > strong { font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .vehicle-price strong > span { font-size: 10px; font-weight: 500; }
  .agent-action { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 10px 14px; color: oklch(0.23 0.025 45); background: oklch(0.91 0.027 75); border: 1px solid transparent; border-radius: 7px; font: inherit; font-size: 12px; font-weight: 650; cursor: pointer; transition: background 160ms ease-out, transform 160ms ease-out; }
  .agent-action:hover { background: oklch(0.96 0.014 75); }
  .agent-action:active { transform: translateY(1px); }
  .agent-action > span { font-size: 16px; font-weight: 500; line-height: 1; }
  button:focus-visible { outline: 2px solid var(--agent-accent); outline-offset: 4px; }
  [tabindex="-1"]:focus-visible { outline: none; }
  .agent-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px 12px; padding: 11px 24px; color: var(--agent-muted); border-top: 1px solid var(--agent-line); font-size: 10px; }
  .agent-footer > span:first-child { display: flex; align-items: center; gap: 6px; }
  .agent-footer i { width: 5px; height: 5px; border-radius: 50%; background: oklch(0.75 0.086 159); }
  .booking-car { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 15px; }
  .booking-car strong { font-size: 15px; font-weight: 600; }
  .booking-car > span { color: var(--agent-muted); font-size: 10px; }
  .booking-summary { margin: 13px 0 16px; }
  .booking-summary > div { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-top: 6px; font-size: 10px; }
  .booking-summary dt { color: var(--agent-muted); }
  .booking-summary dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
  .booking-summary .summary-total { padding-top: 10px; margin-top: 10px; border-top: 1px solid var(--agent-line); font-size: 12px; }
  .summary-total dt { color: var(--agent-ink); }
  .summary-total dd { font-weight: 650; }
  .agent-back { display: block; min-height: 44px; margin: 6px auto -6px; padding: 6px 12px; color: var(--agent-muted); background: none; border: 0; border-radius: 3px; font: inherit; font-size: 11px; cursor: pointer; }
  .agent-back:hover { color: var(--agent-ink); }
  .success-panel { padding-top: 2px; text-align: center; }
  .success-mark { display: grid; place-items: center; width: 40px; height: 40px; margin: 0 auto 10px; color: oklch(0.8 0.09 158); border: 1px solid oklch(0.8 0.09 158 / 0.25); border-radius: 50%; background: oklch(0.8 0.09 158 / 0.07); }
  .success-mark svg { width: 30px; height: 30px; }
  .success-panel h4 { font-size: 17px; font-weight: 600; letter-spacing: -0.025em; }
  .success-car { margin-top: 8px !important; font-size: 11px; }
  .success-dates { margin-top: 3px !important; color: var(--agent-muted); font-size: 10px; }
  .success-note { margin: 13px auto 17px !important; color: oklch(0.8 0.06 58); font-size: 10px; }
  .reset-action { background: transparent; color: var(--agent-ink); border-color: var(--agent-line); }
  .reset-action:hover { background: oklch(0.3 0.012 250); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px !important; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 420px) {
    .agent-header { padding: 15px 16px; }
    .agent-conversation { padding: 18px 16px 17px; }
    .agent-footer { padding: 11px 16px; }
    .customer-message { max-width: 100%; padding: 10px 12px; }
    .tool-steps { gap: 6px; }
    .vehicle-row { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 7px 10px; padding: 11px 10px; }
    .radio-mark { grid-column: 1; grid-row: 1; align-self: start; margin-top: 3px; }
    .vehicle-details { grid-column: 2; grid-row: 1; }
    .vehicle-price { grid-column: 2; grid-row: 2; flex-direction: row; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 2px 8px; margin-left: 0; text-align: left; white-space: normal; }
    .vehicle-price > strong, .vehicle-price > span { white-space: nowrap; }
    .booking-summary > div { gap: 10px; }
    .booking-summary dt { max-width: 44%; }
  }
  @media (prefers-reduced-motion: reduce) { .vehicle-row, .agent-action { transition: none; } }
</style>
